title = getTitle();
run("Split Channels");
c1 = "C1-" + title;
c2 = "C2-" + title;
c3 = "C3-" + title;

selectWindow(c2);
run("Z Project...", "projection=[Max Intensity]");
c2MAX1 = getTitle();

c = roiManager("count");
for (i = 0; i < c; i++) {
    selectWindow(c2MAX1);
    roiManager("Select", i);
    setAutoThreshold("Otsu dark");
    run("Threshold...");
    roiManager("Select", i);
    run("Analyze Particles...", "show=Nothing summarize");
}

selectWindow(c1);
run("Z Project...", "projection=[Max Intensity]");
c1MAX1 = getTitle();

c = roiManager("count");
for (i = 0; i < c; i++) {
    selectWindow(c1MAX1);
    roiManager("Select", i);
    setAutoThreshold("Otsu dark");
    run("Threshold...");
    roiManager("Select", i);
    run("Analyze Particles...", "show=Nothing summarize");
}

run("Close All");
roiManager("reset");
